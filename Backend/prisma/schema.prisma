generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  google
}

enum Status {
  pending
  accepted 
  rejected
}

enum Role {
  admin
  manager
  member 
}  

enum MessageType {
  TEXT
  IMAGE
  FILE
}


model User {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  email        String       @unique
  password     String?
  googleId     String?      @unique
  activeorg    Int?          
  org org? @relation(fields: [activeorg], references: [id], onDelete: SetNull)
  authProvider AuthProvider @default(local)
  createdAt    DateTime     @default(now())

  projectMemberships proj_member[]
  projectAssigner    project[]
  createdTasks       task[] @relation("TaskCreator")
  createdTasksmessage message[]
  task_assignee task_assignee[]
  org_member   org_member[]
  AuditLog     AuditLog[]
}

model org {
  id           Int          @id @default(autoincrement())
  name         String       
  userId       Int 
  member_count Int 
  proj_count   Int 
  role         String       @default("admin")
  createdAt    DateTime     @default(now())

  members      org_member[]
  user         User[]
  task         task[]
  project      project[]
  task_assignee task_assignee[]
  AuditLog      AuditLog[]

  @@index([userId]) 
  @@index([id])
}

model org_member {
  id           Int    @id @default(autoincrement())
  org_id       Int
  member_id    Int
  member_email String
  role         String @default("member")

  org          org    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user         User   @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@unique([member_id,org_id])
  @@index([org_id])
}

model project {
  id           Int          @id @default(autoincrement())
  name         String
  org_id       Int
  assigned_to  Int?
  Description  String 
  status       String 
  priority     String
  endDate      DateTime 
  last_update  DateTime    @default(now()) 
  members      proj_member[]
  tasks        task[]
  task_assignee task_assignee[]

  member       User?    @relation(fields: [assigned_to], references: [id], onDelete: SetNull)
  org          org     @relation(fields: [org_id], references: [id], onDelete: Cascade )

  createdAt    DateTime     @default(now())
  @@index([org_id])
}

model proj_member {
  id           Int         @id @default(autoincrement())
  proj_id      Int 
  org_id       Int 
  member_id    Int 
  role         Role 

  project      project     @relation(fields: [proj_id], references: [id], onDelete: Cascade)
  member       User    @relation(fields: [member_id], references: [id], onDelete: Cascade)
  @@index([org_id, member_id])
  @@index([proj_id, member_id])
  @@index([proj_id])
  @@unique([proj_id, member_id])
}

model task {
  id           Int    @id @default(autoincrement())
  name         String
  Description  String 
  Status       String 
  priority     String 
  dueDate      DateTime
  created_by   Int?
  project_id   Int
  org_id       Int 

  creator  User?    @relation("TaskCreator", fields: [created_by], references: [id], onDelete: SetNull)

  project  project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  org      org      @relation(fields: [org_id], references: [id], onDelete: Cascade)

  assignees task_assignee[]
  task_message   message[]

  @@index([project_id])
  @@index([org_id])
  @@index([org_id, Status])
  @@index([org_id, dueDate])    
  createdAt DateTime @default(now())
}

model task_assignee {
  id        Int  @id @default(autoincrement())
  task_id   Int
  user_id   Int
  proj_id   Int 
  org_id    Int

  project   project @relation(fields: [proj_id], references: [id], onDelete: Cascade)
  task      task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user      User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  org       org @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@index([proj_id])
  @@index([user_id, org_id])
  @@index([task_id])    
}

model teaminvitation {
  id           Int          @id @default(autoincrement()) 
  sender_id    Int 
  receiver_id  Int
  receiver_email String 
  org_id       Int
  message      String 
  status       Status       @default(pending)             
  createdAt    DateTime     @default(now())               
  @@unique([receiver_id, org_id])
  @@index([receiver_id])
  @@index([sender_id])
  @@index([org_id])
}

model message {
  id        Int      @id @default(autoincrement())
  task_id   Int
  user_id   Int?

  type      MessageType
  content   String?

  fileUrl   String? 
  fileName  String?
  mimeType  String?
  task      task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user      User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  @@index([task_id])
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  orgId        Int?
  proj_id      Int?
  userId       Int?
  action       String?   // CREATED | UPDATED | DELETED | ASSIGNED | UNASSIGNED | STATUS_CHANGED | PRIORITY_CHANGED
  resourceType String?   // ORG | PROJECT | TASK | MEMBER
  resourceId   String?   // store as string — works for both Int IDs and UUIDs
  
  oldValue     Json?
  newValue     Json?
  metadata     Json?    // ip, userAgent
  createdAt    DateTime @default(now())

  org  org?   @relation(fields: [orgId],  references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([orgId, action])
  @@index([proj_id])
  @@index([proj_id, createdAt(sort: Desc)])
}
