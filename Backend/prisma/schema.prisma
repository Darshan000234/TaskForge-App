generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  google
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  password     String?
  googleId     String?      @unique
  authProvider AuthProvider @default(local)
  createdAt    DateTime     @default(now())
}